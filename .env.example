# SchedulePro Environment Variables
# Copy this file to config.js values or use environment variables

# Gemini AI API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (get from your Supabase project settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
